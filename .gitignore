# Python virtual environment
.venv/
venv/
env/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# pytest cache
.pytest_cache/

# Environment variables
.env
.env.local
.env.*.local

# IDE and editor settings
.vscode/
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
Spotlight-V100
.TemporaryItems
.Trashes
.Cache
.Even

# Logs
logs/
*.log

# Database
*.db
*.sqlite
*.sqlite3

# Build artifacts
build/
dist/
*.exe

# web/ folder is NOT ignored - it will be tracked by git
!web/

# Ignore Composer dependencies inside web folder
web/vendor/

# Ignore Node.js dependencies inside web folder
web/node_modules/

# Ignore environment files inside web folder
web/.env
web/.env.local
web/.env.production

# Ignore Laravel storage folder inside web folder
web/storage/

# Ignore log files inside web folder
web/storage/logs/*.log
web/*.log

# Ignore IDE folders inside web folder
web/.vscode/
web/.idea/

